From 3f2a9c1e5b7d4a8f6e0c2b1a9d8e7f6c5b4a3920 Mon Sep 17 00:00:00 2001
From: A Dev <dev@example.com>
Subject: [PATCH] Fix the parser

---
 src/parse.rs | 3 ++-
diff --git a/src/parse.rs b/src/parse.rs
index 1a2b3c4..5d6e7f8 100644
--- a/src/parse.rs
+++ b/src/parse.rs
@@ -10,7 +10,8 @@ fn parse(input: &str) -> Result<Ast> {
     let tokens = lex(input);
-    let ast = build(tokens);
+    let ast = build(tokens)?;
+    check(&ast)?;
     Ok(ast)
 }
\ No newline at end of file
