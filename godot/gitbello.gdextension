[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

; Built and copied by `cargo xtask build [--release]` into bin/<os>/<profile>/.
; The native architecture is built, so no arch suffix is needed here.
[libraries]

windows.debug = "res://bin/windows/debug/gitbello_gdext.dll"
windows.release = "res://bin/windows/release/gitbello_gdext.dll"
linux.debug = "res://bin/linux/debug/libgitbello_gdext.so"
linux.release = "res://bin/linux/release/libgitbello_gdext.so"
macos.debug = "res://bin/macos/debug/libgitbello_gdext.dylib"
macos.release = "res://bin/macos/release/libgitbello_gdext.dylib"
