[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://app/history/commit_details.gd" id="1_details"]
[ext_resource type="Script" path="res://app/history/commit_file_list.gd" id="2_files"]
[ext_resource type="PackedScene" path="res://ui/diff_view/diff_panel.tscn" id="3_panel"]
[ext_resource type="PackedScene" path="res://ui/list_header/list_header.tscn" id="4_header"]

[node name="CommitDetails" type="VSplitContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_details")

[node name="InfoPanel" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"DetailsHeader"

[node name="Info" type="VBoxContainer" parent="InfoPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DetailsInfo"

[node name="Summary" type="RichTextLabel" parent="InfoPanel/Info"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 1
mouse_default_cursor_shape = 1
theme_type_variation = &"CommitSummary"
fit_content = true
scroll_active = false
autowrap_mode = 3
context_menu_enabled = true
selection_enabled = true

[node name="Who" type="HFlowContainer" parent="InfoPanel/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DetailsPeople"

[node name="Ids" type="HFlowContainer" parent="InfoPanel/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DetailsRow"

[node name="Date" type="HBoxContainer" parent="InfoPanel/Info/Ids"]
