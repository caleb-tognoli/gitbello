[node name="ChangesView" type="HSplitContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_view")

[node name="Files" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PaneColumn"

[node name="SwitchSlot" type="PanelContainer" parent="Files"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PaneHeader"

[node name="OfferBar" type="PanelContainer" parent="Files"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"OfferBar"

[node name="Row" type="HBoxContainer" parent="Files/OfferBar"]
layout_mode = 2
theme_type_variation = &"ListHeaderRow"

[node name="OfferLabel" type="Label" parent="Files/OfferBar/Row"]
