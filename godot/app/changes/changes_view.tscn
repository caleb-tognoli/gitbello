[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://app/changes/changes_view.gd" id="1_view"]
[ext_resource type="Script" path="res://app/changes/change_list.gd" id="2_list"]
[ext_resource type="Script" path="res://app/changes/commit_box.gd" id="3_commit"]
[ext_resource type="PackedScene" path="res://ui/diff_view/diff_panel.tscn" id="5_panel"]
[ext_resource type="PackedScene" path="res://ui/empty_state/empty_state.tscn" id="6_empty"]
[ext_resource type="Script" path="res://app/changes/shelf_list.gd" id="7_shelves"]
[ext_resource type="PackedScene" path="res://ui/list_header/list_header.tscn" id="8_header"]

[node name="ChangesView" type="HSplitContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_view")

[node name="Files" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PaneColumn"

[node name="SwitchSlot" type="PanelContainer" parent="Files"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PaneHeader"

[node name="OfferBar" type="PanelContainer" parent="Files"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"OfferBar"

[node name="Row" type="HBoxContainer" parent="Files/OfferBar"]
layout_mode = 2
theme_type_variation = &"ListHeaderRow"

[node name="OfferLabel" type="Label" parent="Files/OfferBar/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="OfferButton" type="Button" parent="Files/OfferBar/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Restore"

[node name="ListHeader" parent="Files" instance=ExtResource("8_header")]
unique_name_in_owner = true
layout_mode = 2

[node name="List" type="Control" parent="Files"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("2_list")

[node name="Shelves" type="VBoxContainer" parent="Files"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PaneColumn"
script = ExtResource("7_shelves")

[node name="CommitPanel" type="PanelContainer" parent="Files"]
layout_mode = 2
theme_type_variation = &"CommitPanel"

[node name="CommitBox" type="VBoxContainer" parent="Files/CommitPanel"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("3_commit")

[node name="Summary" type="LineEdit" parent="Files/CommitPanel/CommitBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Summary (required)"

[node name="Body" type="TextEdit" parent="Files/CommitPanel/CommitBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Description"
wrap_mode = 1

[node name="Amend" type="CheckBox" parent="Files/CommitPanel/CommitBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Amend last commit"

[node name="CommitButton" type="Button" parent="Files/CommitPanel/CommitBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Commit"
text_overrun_behavior = 3

[node name="Output" type="TextEdit" parent="Files/CommitPanel/CommitBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ErrorOutput"
editable = false

[node name="Right" type="Control" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="DiffPanel" parent="Right" instance=ExtResource("5_panel")]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Empty" parent="Right" instance=ExtResource("6_empty")]
unique_name_in_owner = true
visible = false
layout_mode = 1
